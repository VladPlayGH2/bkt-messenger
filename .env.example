# SMS via Twilio Verify (recommended)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_new_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legacy direct SMS mode (only if you deliberately use it)
# TWILIO_FROM=+10000000000

# Optional alternative provider
# SMS_WEBHOOK_URL=https://your-provider.example/send
